<article class="border-t border-gray-200 lg:border-0 first:border-0 pt-4 space-y-1 mb-2">
  <% period = agenda_period(agenda) %>
  <% if period.present? %>
    <p class="text-sm text-gray-500"><%= period %></p>
  <% end %>
  <h1>
    <% if agenda.speakers.any? %>
      <%= link_to agenda.subject, agenda.speakers.first, class: 'text-red-500 font-semibold' %>
    <% else %>
      <span class="text-red-500 font-semibold"><%= agenda.subject %></span>
    <% end %>
  </h1>
  <p><%= agenda_speaker_links(agenda.speakers) %></p>
  <p>
    <% if agenda.language.present? %>
      <% if agenda.translated? %>
        <span class="rounded px-1 text-sm bg-blue-500 text-white">
          <%= agenda.language %> → <%= agenda.translated_language %>
        </span>
      <% else %>
        <span class="rounded px-1 text-sm bg-blue-500 text-white"><%= agenda.language %></span>
      <% end %>
    <% end %>
  </p>
  <p>
    <% agenda.tags.each do |tag| %>
      <span class="rounded px-1 text-sm bg-red-500 text-white"><%= tag.name %></span>
    <% end %>
  </p>
</article>
